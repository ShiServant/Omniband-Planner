# Shown in the sidebar. Safe to expose to the browser.
NEXT_PUBLIC_SITE_NAME="Society Project Hub"

# Server-only Supabase access. Do not prefix these with NEXT_PUBLIC_.
# The browser never talks to Supabase.
# Publishable key: low-privilege reads. Respects row level security.
# Secret key: privileged writes. Server-only. Never expose it to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Shared committee edit gate. Server-only.
ADMIN_PASSWORD=
# Long random string used to sign the edit-session cookie.
ADMIN_SESSION_SECRET=
